name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: Name and version (or alias) of the versioned W&B dataset containing the raw rental data to clean.
        type: string

      output_artifact:
        description: Name for the new versioned W&B dataset that will contain the cleaned rental data.
        type: string

      output_type:
        description: Label describing the kind of output dataset being created, for example 'clean_data'.
        type: string

      output_description:
        description: Plain-language description of the output dataset and the cleaning performed on it.
        type: string

      min_price:
        description: Lowest nightly rental price to keep; rows below this value are removed.
        type: float

      max_price:
        description: Highest nightly rental price to keep; rows above this value are removed.
        type: float


    command: >-
        python run.py  --input_artifact {input_artifact}  --output_artifact {output_artifact}  --output_type {output_type}  --output_description {output_description}  --min_price {min_price}  --max_price {max_price} 
